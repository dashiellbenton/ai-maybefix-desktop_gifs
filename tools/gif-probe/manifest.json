{
  "manifest_version": 3,
  "name": "Desktop GIFs probe",
  "version": "0.0.1",
  "description": "Diagnostic for upstream issue #93: tries several ways of sending a GIF comment and reports how YouTube answers each.",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["probe.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
